# Copy to .env (git-ignored) and adjust. Used by compose.yaml and, later, by the backend.
# Local development values only; never put real (AWS) credentials in this file.
DB_NAME=influenceiq
DB_USER=influenceiq
DB_PASSWORD=change-me-local-only
# 5433, not the default 5432, so it doesn't clash with a Postgres installed directly on the machine
DB_PORT=5433
# Load 500 fictional influencers into an empty database when the backend starts (local only)
DEMO_DATA=true
