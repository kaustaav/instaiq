# Copy to .env (git-ignored) and adjust. Used by compose.yaml and by the backend (it reads this file at startup).
# Local development values only; never put real (AWS) credentials in this file.
DB_NAME=influenceiq
DB_USER=influenceiq
DB_PASSWORD=change-me-local-only
# 5433, not the default 5432, so it doesn't clash with a Postgres installed directly on the machine
DB_PORT=5433
# Load 500 fictional influencers into an empty database when the backend starts (local only)
DEMO_DATA=true

# Google sign-in (API mode). The OAuth client ID from the Google Cloud console; same value as the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=123456-abc.apps.googleusercontent.com
# Who may sign in: whole Google Workspace domains and/or single addresses, comma-separated
ALLOWED_DOMAINS=example.com
ALLOWED_EMAILS=someone@example.com
