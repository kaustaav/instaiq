# Copy to .env.local (git-ignored) to change local settings.
#
# Backend API. Unset = demo mode: the UI uses its built-in data and never calls a server.
# "/api" = the local Spring Boot backend, through the Vite dev proxy (see vite.config.ts).
# VITE_API_URL=/api
#
# API mode needs sign-in with Google: the OAuth client ID from the Google Cloud console.
# VITE_GOOGLE_CLIENT_ID=123456-abc.apps.googleusercontent.com

